# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# ── Virtual environment ──────────────────────────────────────────────
venv/
.venv/
env/
myenv/

# ── Scratch / temp files ─────────────────────────────────────────────
scratch/
*.png

# ── Cached raw data (re-downloadable from yfinance) ──────────────────
data/raw/

# ── SQLite database ──────────────────────────────────────────────────
# Ignored so temporary stores (tests, *.building) never get committed.
# data/regime_store.db IS tracked on purpose (added with -f): the dashboard,
# the notebooks, CI and Streamlit Cloud all read the committed store.
*.db

# ── Persisted model artifacts ────────────────────────────────────────
# The walk-forward folds in models/<asset>/ ARE tracked on purpose: they are
# the frozen v1.0 models that --reuse-models and the forward tests rely on.
models/*.joblib

# ── Jupyter ──────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── IDE / OS ─────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Generated outputs that don't belong in git ───────────────────────
models/test/
notebooks/data/
artifacts/
.ruff_cache/
